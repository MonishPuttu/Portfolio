# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development
# Number of proxies in front of the app. Required on Render/Railway/Fly/Vercel
# so rate limiting and contacts.ipAddress see the visitor, not the platform
# proxy. Defaults to 1 when NODE_ENV=production, and off in development.
# TRUST_PROXY=1

# ── Database (Neon PostgreSQL) ──────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── CORS ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (Video Hosting) ─────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: used only for organization/conventions when uploading manually
CLOUDINARY_UPLOAD_FOLDER=portfolio/projects
# Optional: root namespace ownership guard (defaults to first segment of CLOUDINARY_UPLOAD_FOLDER)
CLOUDINARY_ALLOWED_ROOT=portfolio
# Optional: set to false to skip Cloudinary existence checks before saving
CLOUDINARY_VERIFY_ASSET_EXISTENCE=true
# Optional: fallback thumbnail path when media cannot be resolved.
# Must be a file the frontend ships, or it 404s on every page load.
CLOUDINARY_FALLBACK_THUMBNAIL=/thumbnails/default.svg
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
# ── JWT Auth ────────────────────────────────────
JWT_SECRET=your-strong-random-secret-min-32-chars
ADMIN_USERNAME=admin
# Generate with: node -e "import('bcryptjs').then(b=>b.default.hash('yourpassword',12).then(console.log))"
ADMIN_PASSWORD_HASH=$2a$12$...your-bcrypt-hash...

# ── Email (SMTP) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ADMIN_EMAIL=your-admin-email@gmail.com

# ── Visitor notifications ───────────────────────
# One email per visit, sent when the visit ends so it can report how long
# they stayed. Off in development by default — a dev server restarting on
# every save would otherwise mail you dozens of times an afternoon.
# Force it on anywhere with "on", silence production with "off".
# VIEW_NOTIFICATIONS=on
# Timestamps in the email are rendered in this zone ("your time").
OWNER_TIMEZONE=Asia/Kolkata
# How long a silent visit is held open before it is assumed over (ms).
# VISIT_IDLE_MS=180000
# Hard ceiling on a single visit, so a pinned tab cannot hold one open (ms).
# VISIT_MAX_MS=2700000

# ── IP geolocation (optional) ───────────────────
# Turns a visitor's IP into a city. Free tier, no key needed; set to false to
# skip the lookup entirely and send notifications without a location.
# GEOIP_ENABLED=true
# GEOIP_URL=https://ipwho.is/{ip}
# GEOIP_TIMEOUT_MS=5000
